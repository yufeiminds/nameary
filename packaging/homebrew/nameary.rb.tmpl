class Nameary < Formula
  desc "Find a name before you commit"
  homepage "https://github.com/yufeiminds/nameary"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "{{BASE_URL}}/nameary_{{VERSION}}_darwin_arm64.tar.gz"
      sha256 "{{SHA_DARWIN_ARM64}}"
    end

    on_intel do
      url "{{BASE_URL}}/nameary_{{VERSION}}_darwin_amd64.tar.gz"
      sha256 "{{SHA_DARWIN_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "{{BASE_URL}}/nameary_{{VERSION}}_linux_arm64.tar.gz"
      sha256 "{{SHA_LINUX_ARM64}}"
    end

    on_intel do
      url "{{BASE_URL}}/nameary_{{VERSION}}_linux_amd64.tar.gz"
      sha256 "{{SHA_LINUX_AMD64}}"
    end
  end

  def install
    bin.install "nameary"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/nameary version")
  end
end
